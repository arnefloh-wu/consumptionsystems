isplay":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<strong>Wie zufrieden sind Sie mit den Diensten des Mobilfunkanbieters?<\/strong><br>\n<br>\nSie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehne v\u00f6llig ab\" und \"stimme v\u00f6llig zu\" abzustufen. Da es bei den Fragen um pers\u00f6nliche Einsch\u00e4tzungen und Erfahrungen geht, gibt es keine richtigen oder falschen Antworten.","DataExportTag":"Q45","QuestionID":"QID45"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Please rate the following statements regarding the services of this mobile phone provider.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Please rate the following statements regarding the services of this mobile phone provider.<\/strong>","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":451,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please rate the following statements regarding the services of this mobile phone provider.","Choices":{"1":{"Display":"I would like to continue using the services of this mobile phone provider for many years to come."},"2":{"Display":"The services offered by this mobile phone provider are and will remain my first choice."},"3":{"Display":"If I could get this mobile phone provider's services for free, I would choose them."},"4":{"Display":"I recommend the services of this mobile phone provider to people who seek my advice."},"5":{"Display":"I recommend the services of this mobile phone provider to my friends and relatives."},"6":{"Display":"I encourage friends and relatives to purchase the services of this mobile phone provider."},"7":{"Display":"I express positive opinions about this mobile phone provider's services in internet blogs, forums, etc."},"8":{"Display":"I speak positively about the services of this mobile phone provider in personal conversations."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"ColumnLabels":[{"Display":"strongly disagree","IsLabelDefault":false},{"Display":"strongly agree","IsLabelDefault":false}],"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<strong>Bitte beurteilen Sie folgende Aussagen in Bezug auf die Dienste dieses Mobilfunkanbieters.<\/strong>","DataExportTag":"Q46","QuestionID":"QID46"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"The likelihood that I will choose this mobile phone provider's services again is","TertiaryAttribute":null,"Payload":{"QuestionText":"The likelihood that I will choose this mobile phone provider's services again is","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"The likelihood that I will choose this mobile phone provider's services again is","Choices":{"1":{"Display":"very low"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"very high"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"Die Wahrscheinlichkeit, dass ich mich wieder f\u00fcr die Dienste dieses Mobilfunkanbieters entscheide, ist","DataExportTag":"Q47","QuestionID":"QID47"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Please read the following experience report carefully and try to put yourself in the situation: Y...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Please read the following experience report carefully and try to put yourself in the situation<\/strong>: You have had a new cell phone and a new mobile phone provider for some time now. You purchased both together as a complete package, which is why you cannot use your cell phone without the services of your mobile phone provider and the services of your mobile phone provider without your cell phone. <strong>Your experience so far has been as follows: Your mobile phone provider's services are unreliable<\/strong> and <strong>not very user-friendly<\/strong>. <strong>Using the services is cumbersome and not enjoyable<\/strong>. Your mobile phone provider also <strong>does not offer any exciting services<\/strong> that motivate you to use them frequently. The <strong>cost<\/strong> of the services is very <strong>high<\/strong> compared to the performance and prices of competing providers. Your friends have rightly <strong>advised you against this mobile phone provider<\/strong>. It is better not to mention that you have decided to go with this mobile phone provider after all. <br><strong><br>As mentioned, your mobile phone also belongs to your mobile phone provider. Please read this review carefully and try to put yourself in the situation<\/strong>: <strong>Your mobile phone is very reliable and user-friendly<\/strong>. It is <strong>easy to understand<\/strong> and pleasant to use. You <strong>enjoy<\/strong> using your cell phone, and its multifunctionality motivates you to use it frequently. Your cell phone is also inexpensive compared to similar models. You feel that you have received a very good product for your money. Your friends are enthusiastic about your cell phone and comment positively on it. You feel that your cell phone makes you more popular with others, so you like to show it off.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read the following experience report carefully and try to put yourself in the situation: Y...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Lesen Sie bitte folgenden Erfahrungsbericht sorgf&auml;ltig durch und versuchen Sie sich in die Situation hineinzuversetzen:<\/strong><br \/>\nSie haben seit einiger Zeit ein neues Handy sowie einen neuen Mobilfunkanbieter. Beides haben Sie gemeinsam, als Komplettpaket, erworben, weshalb Sie <strong>Ihr Handy nicht ohne die Dienste Ihres Mobilfunkanbieters, und die Dienste Ihres Mobilfunkanbieters nicht ohne Ihr Handy nutzen k&ouml;nnen.<\/strong><br \/>\n<br \/>\n<strong>Ihre bisherigen Erfahrungen sind wie folgt:<\/strong><br \/>\nDie Dienste Ihres <strong>Mobilfunkanbieters<\/strong> sind <strong>unzuverl&auml;ssig<\/strong> und <strong>nicht sehr nutzerfreundlich<\/strong>. Die <strong>Verwendung der Dienste ist beschwerlich<\/strong> und macht keinen Spa&szlig;. Auch verf&uuml;gt Ihr Mobilfunkanbieter &uuml;ber <strong>keine spannenden Services<\/strong>, die Sie zu einer h&auml;ufigen Verwendung motivieren. Die <strong>Kosten<\/strong> f&uuml;r die Dienste sind im Vergleich zu der Leistung, und zu den Preisen der Konkurrenzanbieter, sehr <strong>hoch<\/strong>. Ihre Bekannten haben Ihnen mit Recht <strong>von diesem Mobilfunkanbieter abgerate<\/strong>n. Sie werden besser nicht erw&auml;hnen, dass Sie sich doch f&uuml;r diesen Mobilfunkanbieter entschieden haben.","DataExportTag":"Q48","QuestionID":"QID48"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"How do you assess this situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do you assess this situation?","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Bipolar","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How do you assess this situation?","Choices":{"1":{"Display":"positive:negative"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":7,"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"}},"AnswerOrder":[1,2,3,4,5,6],"AnswerColumns":6,"ChoiceDataExportTags":false,"ColumnLabels":[{"Display":"1","IsLabelDefault":false},{"Display":"2","IsLabelDefault":false},{"Display":"3","IsLabelDefault":false},{"Display":"4","IsLabelDefault":false},{"Display":"5","IsLabelDefault":false},{"Display":"6","IsLabelDefault":false},{"Display":"7","IsLabelDefault":false}],"QuestionText_Unsafe":"Wie beurteilen Sie diese Situation?","DataExportTag":"Q49","QuestionID":"QID49"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"How old are you?","TertiaryAttribute":null,"Payload":{"QuestionText":"How old are you?","DefaultChoices":false,"DataExportTag":"Q5","QuestionID":"QID5","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How old are you?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"Surv
"SubSelector":"TX"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"Do you want to see debriefing information?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you want to see debriefing information?","DefaultChoices":false,"DataExportTag":"Q57","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Do you want to see debriefing information?","Choices":{"1":{"Display":"No"},"2":{"Display":"Yes"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID57"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Aim of this study is to explore consumers' perceptions regarding their mobile services and mobile...","TertiaryAttribute":null,"Payload":{"QuestionText":"Aim of this study is to explore consumers' perceptions regarding their mobile services and mobile phones as well as to investigate, whether there are spill-over effects between those perceptions.","DefaultChoices":false,"DataExportTag":"Q58","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Aim of this study is to explore consumers' perceptions regarding their mobile services and mobile...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID58","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID57\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Do you want to see debriefing information?<\/span> <span class=\"LeftOpDesc\">Yes<
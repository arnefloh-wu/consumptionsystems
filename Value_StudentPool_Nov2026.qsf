tionMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"DE":[]},"ProtectSelectionIds":true}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Dear Students, Thanks for taking part in this survey. It is about telecommunication services. In...","TertiaryAttribute":null,"Payload":{"QuestionText":"Dear Students,<br><br>Thanks for taking part in this survey. It is about telecommunication services.<br>In case you have any questions, please let us know: monika.koller@wu.ac.at<br><br>Thank you very much for participating.<br>Best wishes<br>Monika Koller and Arne Floh<br>","DefaultChoices":false,"DataExportTag":"Q1","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dear Students, Thanks for taking part in this survey. It is about telecommunication services. In...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Bitte denken Sie bei der Beantwortung der folgenden Fragen an den soeben dargestellten Erfahrungs...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><span style=\"color:#e74c3c;\">Bitte denken Sie bei der Beantwortung der folgenden Fragen an den soeben dargestellten Erfahrungsbericht.&nbsp;<\/span><\/strong>","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Bitte denken Sie bei der Beantwortung der folgenden Fragen an den soeben dargestellten Erfahrungs...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Wie beurteilen Sie dieses Handy? Sie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehne v\u00f6llig.","TertiaryAttribute":null,"Payload":{"QuestionText":"Wie beurteilen Sie dieses Handy?<br>\n<br>\nSie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehne v\u00f6llig ab\" und \"stimme v\u00f6llig zu\" abzustufen. Da es bei den Fragen um pers\u00f6nliche Einsch\u00e4tzungen und Erfahrungen geht, gibt es keine richtigen oder falschen Antworten.","DefaultChoices":false,"DataExportTag":"Q11","QuestionID":"QID11","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Wie beurteilen Sie dieses Handy? Sie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehne v\u00f6llig...","Choices":{"1":{"Display":"Dieses Handy hat hohen Wert f\u00fcr mich."},"2":{"Display":"Dieses Handy ist sehr gut im Vergleich zu anderen am Markt verf\u00fcgbaren Produkten,."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":8,"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"ColumnLabels":[{"Display":"lehne v\u00f6llig ab","IsLabelDefault":false},{"Display":"stimme v\u00f6llig zu","IsLabelDefault":false}]}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Insgesamt ist der Wert dieses Handy f\u00fcr mich:","TertiaryAttribute":null,"Payload":{"QuestionText":"Insgesamt ist der Wert dieses Handy f\u00fcr mich:","DefaultChoices":false,"DataExportTag":"Q12","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Insgesamt ist der Wert dieses Handy f\u00fcr mich:","Choices":{"1":{"Display":"sehr niedrig"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"sehr hoch"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID12"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Wie zufrieden sind Sie mit diesem Handy? Sie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehn..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Wie zufrieden sind Sie mit diesem Handy?<\/strong><br \/>\n<br \/>\nSie haben die M&ouml;glichkeit, Ihre Antworten zwischen &quot;lehne v&ouml;llig ab&quot; und &quot;stimme v&ouml;llig zu&quot; abzustufen. Da es bei den Fragen um pers&ouml;nliche Einsch&auml;tzungen und Erfahrungen geht, gibt es keine richtigen oder falschen Antworten.","DefaultChoices":false,"DataExportTag":"Q13","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":389},"QuestionDescription":"Wie zufrieden sind Sie mit diesem Handy? Sie haben die M\u00f6glichkeit, Ihre Antworten zwischen \"lehn...","Choices":{"1":{"Display":"Dieses Handy ist genau das, was ich brauche."},"2":{"Display":"Ich bin mit diesem Handy sehr zufrieden."},"3":{"Display":"Ich bin mir sicher, dass es richtig war, dieses Handy zu kaufen."},"4":{"Display":"Dieses Handy ist das Beste, das ich bekommen konnte."},"5":{"Display":"Dieses Handy hat alle meine Erwartungen erf\u00fcllt."}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":9,"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID13","ColumnLabels":[{"Display":"lehne v\u00f6llig ab","IsLabelDefault":false},{"Display":"stimme v\u00f6llig zu","IsLabelDefault":false}]}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Bitte beurteilen Sie folgende Aussagen in Bezug auf dieses Handy.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Bitte beurteilen Sie folgende Aussagen in Bezug auf dieses Handy.<\/strong>","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":451},"QuestionDescription":"Bitte beurteilen Sie folgende Aussagen in Bezug auf dieses Handy.","Choices":{"1":{"Display":"Ich m\u00f6chte dieses Handy noch viele Jahre verwenden."},"2":{"Display":"Ich m\u00f6chte dieses Handy noch viele Jahre verwenden."},"3":{"Display":"Wenn ich dieses Handy gratis bekommen k\u00f6nnte, w\u00fcrde ich es ausw\u00e4hlen."},"4":{"Display":"Ich empfehle dieses Handy Personen, die meinen Rat suchen."},"5":{"Display":"Ich empfehle dieses Handy meinen Freunden und Verwandten."},"6":{"Display":"Ich ermuntere Freunde und Verwandte, dieses Handy zu kaufen."},"7":{"Display":"Ich \u00e4u\u00dfere mich in Internet Blogs, Foren etc. positiv \u00fcber dieses Handy."},"8":{"Display":"Ich \u00e4u\u00dfere mich in pers\u00f6nlichen Gespr\u00e4chen positiv \u00fcber dieses Handy."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID14","ColumnLabels":[{"Display":"lehne v\u00f6llig ab","IsLabelDefault":false},{"Display":"stimme v\u00f6llig zu","IsLabelDefault":false}]}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Die Wahrscheinlichkeit, dass ich mich wieder f\u00fcr dieses Handy entscheide, ist","TertiaryAttribute":null,"Payload":{"QuestionText":"Die Wahrscheinlichkeit, dass ich mich wieder f\u00fcr dieses Handy entscheide, ist","DefaultChoices":false,"DataExportTag":"Q15","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Die Wahrscheinlichkeit, dass ich mich wieder f\u00fcr dieses Handy entscheide, ist","Choices":{"1":{"Display":"sehr niedrig"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"sehr hoch"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Lesen Sie bitte folgenden Erfahrungsbericht sorgf\u00e4ltig durch und versuchen Sie sich in die Situat..","TertiaryAttribute":null,"Payload":{"QuestionText":"<u>Lesen Sie bitte folgenden Erfahrungsbericht sorgf\u00e4ltig durch und versuchen Sie sich in die Situation hineinzuversetzen:<\/u><br>\nSie haben seit einiger Zeit ein neues Handy sowie einen neuen Mobilfunkanbieter. Beides haben Sie gemeinsam als Komplettpaket erworben, weshalb Sie es <strong>nicht ohne die Dienste Ihres Mobilfunkanbieters und die Dienste Ihres Mobilfunkanbieters nicht ohne Ihr Handy nutzen k\u00f6nnen<\/strong>.<br>\n<br>\n<u>Ihre bisherigen Erfahrungen sind wie folgt:<\/u><br>\nLeider ist Ihr <strong>Handy unzuverl\u00e4ssig<\/strong> und die <strong>Bedienung kompliziert<\/strong>. Es ist nicht besonders multifunktional, und die wenigen Funktionen, \u00fcber die es verf\u00fcgt, machen <strong>keinen Spa\u00df<\/strong> und motivieren nicht dazu, das Handy h\u00e4ufig zu verwenden. Verglichen mit der Leistung war der <strong>Preis<\/strong>, den Sie f\u00fcr das Handy gezahlt haben, <strong>hoch<\/strong>. \u00c4hnliche Modelle von anderen Herstellern sind viel preiswerter. Ihre Bekannten haben Ihnen mit Recht <strong>von diesem Ger\u00e4t abgeraten<\/strong>, und Sie werden nicht erw\u00e4hnen, dass Sie sich doch daf\u00fcr entschieden haben.","DefaultChoices":false,"DataExportTag":"Q16","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Lesen Sie bitte folgenden Erfahrungsbericht sorgf\u00e4ltig durch und versuchen Sie sich in die Situat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID16"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Wie beurteilen Sie diese Situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"Wie beurteilen Sie diese Situation?","DefaultChoices":false,"DataExportTag":"Q17","QuestionType":"Matrix","Selector":"Bipolar","DataVisibility":{"Private":false,"Hidden":false},"Configuratio
uage":[],"NextChoiceId":6,"NextAnswerId":9,"ColumnLabels":[{"Display":"strongly disagree","IsLabelDefault":false},{"Display":"strongly agree","IsLabelDefault":false}],"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID29"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Zu Beginn des Fragebogens d\u00fcrfen wir Sie bitten, einige Angaben zu Ihrer Person zu machen.","TertiaryAttribute":null,"Payload":{"QuestionText":"Zu Beginn des Fragebogens d\u00fcrfen wir Sie bitten, einige Angaben zu Ihrer Person zu machen.","DefaultChoices":false,"DataExportTag":"Q3","QuestionID":"QID3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Zu Beginn des Fragebogens d\u00fcrfen wir Sie bitten, einige Angaben zu Ihrer Person zu machen.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Please rate the following statements regarding the services of this mobile phone provider.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Please rate the following statements regarding the services of this mobile phone provider<\/strong>.","DefaultChoices":false,"DataExportTag":"Q30","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":451,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please rate the following statements regarding the services of this mobile phone provider.","Choices":{"1":{"Display":"I would like to continue using the services of this mobile phone provider for many years to come."},"2":{"Display":"The services offered by this mobile phone provider are and will remain my first choice."},"3":{"Display":"If I could get this mobile phone provider's services for free, I would choose them."},"4":{"Display":"I recommend the services of this mobile phone provider to people who seek my advice."},"5":{"Display":"I recommend the services of this mobile phone provider to my friends and relatives."},"6":{"Display":"I encourage friends and relatives to purchase the services of this mobile phone provider."},"7":{"Display":"I speak positively about this mobile phone provider's services in personal conversations."},"8":{"Display":"I encourage friends and relatives to purchase the services of this mobile phone provider."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"ColumnLabels":[{"Display":"strongly disagree","IsLabelDefault":false},{"Display":"strongly agree","IsLabelDefault":false}],"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID30"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"The likelihood that I will choose this mobile phone provider's services again is","TertiaryAttribute":null,"Payload":{"QuestionText":"The likelihood that I will choose this mobile phone provider's services again is","DefaultChoices":false,"DataExportTag":"Q31","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"The likelihood that I will choose this mobile phone provider's services again is","Choices":{"1":{"Display":"very low"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"very high"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"Please read the following experience report carefully and try to put yourself in the situation: Y...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Please read the following experience report carefully and try to put yourself in the situation<\/strong>: You have had a new cell phone and a new mobile phone provider for some time now. You purchased both together as a complete package, <strong>which is why you cannot use your cell phone without the services of your mobile phone provider, and you cannot use the services of your mobile phone provider without your cell phone. Your experience so far has been as follows<\/strong>: Your <strong>mobile phone provider&#39;s services<\/strong> are <strong>unreliable<\/strong> and <strong>not very user-friendly<\/strong>. <strong>Using the services is cumbersome and not enjoyable<\/strong>. Your mobile phone provider also <strong>does not offer any exciting services<\/strong> that motivate you to use them frequently. The <strong>cost <\/strong>of the services is <strong>very high<\/strong> compared to the performance and prices of competing providers. Your friends have rightly <strong>advised you against this mobile phone provider<\/strong>. It is better not to mention that you have decided to use this mobile phone provider after all.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read the following experience report carefully and try to put yourself in the situation: Y...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Lesen Sie bitte folgenden Erfahrungsbericht sorgf&auml;ltig durch und versuchen Sie sich in die Situation hineinzuversetzen:<\/strong><br \/>\nSie haben seit einiger Zeit ein neues Handy sowie einen neuen Mobilfunkanbieter. Beides haben Sie gemeinsam, als Komplettpaket, erworben, weshalb Sie <strong>Ihr Handy nicht ohne die Dienste Ihres Mobilfunkanbieters, und die Dienste Ihres Mobilfunkanbieters nicht ohne Ihr Handy nutzen k&ouml;nnen.<\/strong><br \/>\n<br \/>\n<strong>Ihre bisherigen Erfahrungen sind wie folgt:<\/strong><br \/>\nDie Dienste Ihres <strong>Mobilfunkanbieters<\/strong> funktionieren stets <strong>einwandfrei<\/strong> und Sie k&ouml;nnen sich immer darauf verlassen, erreichbar zu sein. Die angebotenen Dienste machen <strong>Spa&szlig;<\/strong> und erlauben eine unbeschwerte Nutzung. Sie verwenden die <strong>Dienste Ihres Mobilfunkanbieters sehr gerne und h&auml;ufig<\/strong>. Noch dazu sind die f&uuml;r die Dienste im Gegensatz zu den Konkurrenzanbietern sehr niedrig. Viele Ihrer Bekannten nutzen Ihren Anbieter ebenfalls, und <strong>&auml;u&szlig;ern sich positiv dar&uuml;ber.<\/strong> Sie haben das Gef&uuml;hl, dass Ihr Mobilfunkanbieter derzeit sehr angesagt ist, und dass auch sie dadurch <strong>bei anderen besser ankommen<\/strong>.","DataExportTag":"Q32","QuestionID":"QID32"}},{"SurveyID":"SV_01lKiDEHDEr1TAq","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"How do you assess this situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do you assess this situation?","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Bipolar","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescrip